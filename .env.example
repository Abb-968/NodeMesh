# Configuración del nodo de ESTA PC (un nodo por PC).
# Copia este archivo a .env y ajusta los valores.
# Las variables definidas en la terminal tienen prioridad sobre este archivo.

# Identidad del nodo (uno distinto por PC: nodo-a, nodo-b, nodo-c)
NODE_ID=nodo-a

# Puerto del nodo (todos usan el mismo; cada PC tiene el suyo)
PORT=3001

# IPs de las otras PCs que corren los demás nodos (separadas por comas)
PEERS=http://IP-PC-NODO-B:3001,http://IP-PC-NODO-C:3001
