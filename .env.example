# Configuración del nodo de ESTA PC (un nodo por PC).
# Copia este archivo a .env y ajusta los valores,
# o deja que lo haga por ti: npm run setup

# Identidad del nodo (uno distinto por PC: nodo-a, nodo-b, nodo-c)
NODE_ID=nodo-a

# Puerto del nodo (todos usan el mismo; cada PC tiene el suyo)
PORT=3001

# PEERS=auto -> el nodo descubre solo a los demás en la misma red local.
# Alternativa manual (como en Docker): lista separada por comas
# PEERS=http://IP-NODO-B:3001,http://IP-NODO-C:3001
PEERS=auto
